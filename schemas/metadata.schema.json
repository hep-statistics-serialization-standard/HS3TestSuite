{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hs3testsuite.local/schemas/metadata.schema.json",
  "type": "object",
  "required": ["schema_version", "test_id", "title", "source", "description", "notes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "test_id": { "type": "string" },
    "title": { "type": "string" },
    "source": { "type": "string" },
    "description": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "modified_from_source": { "type": "boolean" },
    "reference_backend": { "type": "string" },
    "semantic": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "conformance": { "type": "array", "items": { "type": "string" } },
    "nll_scans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parameters", "points"],
        "properties": {
          "id": { "type": "string" },
          "parameters": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 1
            }
          },
          "pdf": { "type": "string" },
          "data": { "type": "string" },
          "likelihood": { "type": "string" }
        },
        "oneOf": [
          {
            "required": ["pdf", "data"],
            "properties": { "likelihood": false }
          },
          {
            "required": ["likelihood"],
            "properties": { "pdf": false, "data": false }
          }
        ]
      }
    }
  }
}
