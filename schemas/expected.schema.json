{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hs3testsuite.local/schemas/expected.schema.json",
  "type": "object",
  "required": ["schema_version", "test_id", "checks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "test_id": { "type": "string" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["static_integrity", "structure_import", "twice_delta_nll_scan", "pdf_scan", "function_scan"]
          },
          "target": { "type": "object" },
          "reference_point": { "type": "object" },
          "scan_parameters": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "scan_points": {
            "type": "array",
            "items": { "type": "array", "items": { "type": "number" }, "minItems": 1 }
          },
          "expected": { "type": "array", "items": { "type": "number" } },
          "tolerance": {
            "type": "object",
            "required": ["rtol", "atol"],
            "additionalProperties": false,
            "properties": {
              "rtol": { "type": "number", "minimum": 0 },
              "atol": { "type": "number", "minimum": 0 }
            }
          },
          "comparison": { "type": "object" }
        },
        "allOf": [
          {
            "if": {
              "required": ["kind"],
              "properties": { "kind": { "const": "twice_delta_nll_scan" } }
            },
            "then": {
              "required": [
                "target",
                "reference_point",
                "scan_parameters",
                "scan_points",
                "expected",
                "tolerance"
              ],
              "properties": {
                "target": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["pdf", "data"],
                      "properties": {
                        "pdf": { "type": "string" },
                        "data": { "type": "string" }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["likelihood"],
                      "properties": {
                        "likelihood": { "type": "string" }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "required": ["kind"],
              "properties": { "kind": { "const": "pdf_scan" } }
            },
            "then": {
              "required": [
                "target",
                "reference_point",
                "scan_parameters",
                "scan_points",
                "expected",
                "tolerance"
              ],
              "properties": {
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["pdf", "observables"],
                  "properties": {
                    "pdf": { "type": "string" },
                    "observables": {
                      "type": "array",
                      "items": { "type": "string" },
                      "minItems": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "required": ["kind"],
              "properties": { "kind": { "const": "function_scan" } }
            },
            "then": {
              "required": [
                "target",
                "reference_point",
                "scan_parameters",
                "scan_points",
                "expected",
                "tolerance"
              ],
              "properties": {
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["function"],
                  "properties": {
                    "function": { "type": "string" }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
